# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/fyp_db

# Groq API Configuration (for Whisper Speech-to-Text)
GROQ_API_KEY=your-groq-api-key-here

# JWT Configuration
# CRITICAL: Change this to a secure random string in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
# Stable production model; override only when intentionally changing models.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
# Set to 1 for deterministic local/test runs without network calls.
PRESENTATION_REWRITER_OFFLINE=0
# LanguageTool starts a local Java process; enable explicitly when installed.
PRESENTATION_REWRITER_ENABLE_GRAMMAR_CHECK=0
# Optional absolute output directory. Defaults to <project>/instance/presentation_rewriter.
# PRESENTATION_REWRITER_DOWNLOAD_DIR=
PRESENTATION_REWRITER_MAX_UPLOAD_BYTES=52428800

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Configuration
HOST=0.0.0.0
PORT=5000
